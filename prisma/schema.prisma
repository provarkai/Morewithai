  sourceType        String?
  sourceId          String?

  status            String   @default("PENDING")

  createdAt         DateTime @default(now())
  completedAt       DateTime?

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site              Site?        @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([siteId, status])
}

// ─── PHASE 3 — UNIFIED EVENT LAYER ────────────────────────────

model Event {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String?
  userId         String?
  visitorId      String?
  sessionId      String?
  eventType      String
  entityType     String?
  entityId       String?
  properties     String?
  source         String?
  occurredAt     DateTime
  receivedAt     DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  attributions   RevenueAttribution[]

  @@index([organizationId, occurredAt])
  @@index([siteId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([entityType, entityId])
  @@index([visitorId, sessionId])
}

// ─── PHASE 3 — REVENUE ATTRIBUTION ────────────────────────────

model RevenueAttribution {
  id               String   @id @default(cuid())
  organizationId   String
  siteId           String?
  visitorId        String?
  sessionId        String?
  articleId        String?
  eventId          String?
  leadId           String?
  subscriberId     String?
  offerType        String?
  offerId          String?
  conversionId     String?
  revenueId        String?
  attributedAmount Float
  currency         String   @default("NGN")
  attributionModel String
  occurredAt       DateTime

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site             Site?        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  article          Article?     @relation(fields: [articleId], references: [id], onDelete: SetNull)
  event            Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  lead             Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  subscriber       Subscriber?  @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([siteId, articleId])
  @@index([articleId, occurredAt])
}

// ─── PHASE 3 — CONTENT ECONOMICS ──────────────────────────────

model ContentEconomics {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String
  articleId      String
  periodStart    DateTime
  periodEnd      DateTime
  revenue        Float    @default(0)
  aiCost         Float    @default(0)
  promotionCost  Float    @default(0)
  otherCost      Float    @default(0)
  totalCost      Float    @default(0)
  profit         Float    @default(0)
  roi            Float    @default(0)
  calculatedAt   DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  article        Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, periodStart, periodEnd])
  @@index([organizationId, siteId])
  @@index([siteId, profit])
}

// ─── PHASE 3 — MONEY ENGINE ───────────────────────────────────

model MoneyOpportunity {
  id               String   @id @default(cuid())
  organizationId   String
  siteId           String
  articleId        String?
  opportunityType  String
