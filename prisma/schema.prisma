generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── EXISTING MODELS (PRESERVED) ─────────────────────────────

model Site {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  domain      String?
  isActive    Boolean  @default(true)
  theme       String   @default("default")

  // Phase 3 — Multi-Site SaaS fields
  subdomain       String?
  niche           String?
  brandVoice      String?
  targetAudience  String?
  defaultAuthorId String?
  defaultCategoryId String?
  contentRules    String?
  monetizationSettings String?
  seoSettings     String?
  analyticsSettings String?
  autonomyLevel   String   @default("MANUAL")
  healthScore     Int?
  healthScoreAt   DateTime?
  organizationId  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  feeds       RssFeed[]
  articles    Article[]
  settings    Setting[]
  logs        AutomationLog[]
  authors     Author[]
  categories  Category[]
  tags        Tag[]
  aiJobs      AiJob[]
  userAccess  UserSite[]

  // Phase 2 — Monetization & Growth relations
  subscribers            Subscriber[]
  leads                  Lead[]
  leadMagnets            LeadMagnet[]
  emailCampaigns         EmailCampaign[]
  emailEvents            EmailEvent[]
  emailAutomations       EmailAutomation[]
  ctas                   CallToAction[]
  ctaExperiments         CtaExperiment[]
  affiliatePrograms      AffiliateProgram[]
  affiliateOffers        AffiliateOffer[]
  affiliateClicks        AffiliateClick[]
  products               Product[]
  productPurchases       ProductPurchase[]
  adPlacements           AdPlacement[]
  adEvents               AdEvent[]
  revenueEvents          RevenueEvent[]
  revenueAdjustments     RevenueAdjustment[]
  trafficMetrics         TrafficMetric[]
  searchMetrics          SearchMetric[]
  contentOpportunities   ContentOpportunity[]
  growthRecommendations  GrowthRecommendation[]
  conversionEvents       ConversionEvent[]
  topicClusters          TopicCluster[]
  socialPosts            SocialPost[]
  socialTemplates        SocialTemplate[]
  automationRules        AutomationRule[]
  calendarEvents         ContentCalendarEvent[]
  media                  Media[]
  landingPages           LandingPage[]

  // Phase 3 — Multi-Site SaaS relations
  organization    Organization?  @relation(fields: [organizationId], references: [id])
  defaultAuthor   Author?  @relation("SiteDefaultAuthor", fields: [defaultAuthorId], references: [id])
  contentJobs     ContentJob[]
  approvalTasks   ApprovalTask[]
  scheduledTasks  ScheduledTask[]
  webhooks        Webhook[]
  featureFlags    SiteFeatureFlag[]
  auditLogs       AuditLog[]
  apiKeys         ApiKey[]
  costEvents      CostEvent[]
}

model RssFeed {
  id          String   @id @default(cuid())
  name        String
  url         String
  category    String   @default("AI")
  isActive    Boolean  @default(true)
  lastFetched DateTime?
  fetchCount  Int      @default(0)
  siteId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site        Site     @relation(fields: [siteId], references: [id])
  articles    Article[]

  @@unique([url, siteId])
}

model Article {
  id               String   @id @default(cuid())
  
  // PRESERVED FIELDS — do not remove, existing data depends on these
  title            String
  originalTitle     String
  originalContent  String
  rewrittenTitle    String?
  rewrittenContent String?
  sourceUrl        String
  sourceFeedId     String?
  thumbnailUrl      String?
  errorMessage      String?
  wordpressPostId   Int?
  wordpressUrl      String?
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  seoSchema        String?
  adsenseEnabled   Boolean  @default(true)
  fetchedAt        DateTime @default(now())
  rewrittenAt       DateTime?
  publishedAt       DateTime?

  // NEW FIELDS
  slug             String?
  excerpt          String?
  authorId         String?
  categoryId       String?
  primaryKeyword   String?
  secondaryKeywords String?
  searchIntent     String?
  readingTime      Int?
  wordCount        Int?
  seoScore         Int?
  qualityScore     Int?
  lastReviewedAt   DateTime?
  nextReviewAt     DateTime?
  publishedVersionId String?

  // Status — now validated by workflow (see src/lib/articles/status.ts)
  status           String   @default("fetched")
  scheduledAt       DateTime?

  siteId           String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // RELATIONS
  feed              RssFeed?           @relation(fields: [sourceFeedId], references: [id])
  site              Site               @relation(fields: [siteId], references: [id])
  author            Author?            @relation(fields: [authorId], references: [id])
  category          Category?          @relation(fields: [categoryId], references: [id])
  versions          ArticleVersion[]
  sources           ArticleSource[]
  seoAnalysis       SeoAnalysis?
  contentScore      ContentScore?
  linkRecommendations InternalLinkRecommendation[]  @relation("LinkSource")
  linkTargets         InternalLinkRecommendation[]  @relation("LinkTarget")
  refreshRecords    ContentRefresh[]
  aiJobs            AiJob[]
  tags              ArticleTag[]

  // Phase 2 — Monetization & Growth relations
  leads                  Lead[]
  ctaPlacements          CtaPlacement[]
  affiliateClicks        AffiliateClick[]
  productPurchases       ProductPurchase[]
  adEvents               AdEvent[]
  revenueEvents          RevenueEvent[]
  trafficMetrics         TrafficMetric[]
  searchMetrics          SearchMetric[]
  contentOpportunities   ContentOpportunity[]
  growthRecommendations  GrowthRecommendation[]
  conversionEvents       ConversionEvent[]
  clusterArticles        ClusterArticle[]
  targetingCtas          CallToAction[]
  pillarClusters         TopicCluster[]
  socialPosts            SocialPost[]
  calendarEvents         ContentCalendarEvent[]
  contentJobs           ContentJob[]

  @@unique([sourceUrl, siteId])
  @@index([siteId])
  @@index([status])
  @@index([categoryId])
  @@index([authorId])
  @@index([publishedAt])
  @@index([nextReviewAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String
  value     String
  siteId    String
  updatedAt DateTime @updatedAt

  site      Site     @relation(fields: [siteId], references: [id])

  @@unique([key, siteId])
}

model AutomationLog {
  id        String   @id @default(cuid())
  action    String
  status    String
  message   String
  details   String?
  siteId    String
  createdAt DateTime @default(now())

  site      Site     @relation(fields: [siteId], references: [id])
}

// ─── NEW MODELS — PHASE 1 ─────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("EDITOR")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  siteAccess   UserSite[]
  passwordResets PasswordReset[]
  authorProfiles Author[]

  // Phase 3 — Organization relations
  ownedOrgs       Organization[]  @relation("OrganizationOwner")
  orgMemberships  OrganizationMember[] @relation("OrgMember")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}


model UserSite {
  id     String @id @default(cuid())
  userId String
  siteId String
  role   String @default("EDITOR")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
}

model Author {
  id         String   @id @default(cuid())
  siteId     String
  userId     String?
  name       String
  slug       String
  bio        String?
  avatarUrl  String?
  website    String?
  socialLinks String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  site       Site     @relation(fields: [siteId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
  articles   Article[]
  products   Product[]
  defaultForSites Site[] @relation("SiteDefaultAuthor")

  @@unique([slug, siteId])
  @@index([siteId])
}

model Category {
  id             String   @id @default(cuid())
  siteId         String
  name           String
  slug           String
  description    String?
  seoTitle       String?
  seoDescription String?
  imageUrl       String?
  parentId       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site           Site     @relation(fields: [siteId], references: [id])
  parent         Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryHierarchy")
  articles       Article[]

  @@unique([slug, siteId])
  @@index([siteId])
}

model Tag {
  id          String   @id @default(cuid())
  siteId      String
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site        Site        @relation(fields: [siteId], references: [id])
  articles    ArticleTag[]

  @@unique([slug, siteId])
  @@index([siteId])
}

model ArticleTag {
  articleId String
  tagId     String
  createdAt DateTime @default(now())

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model ArticleVersion {
  id             String   @id @default(cuid())
  articleId      String
  versionNumber  Int
  title          String
  excerpt        String?
  content        String
  createdById    String?
  changeReason   String?
  createdAt      DateTime @default(now())

  article        Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model ArticleSource {
  id           String   @id @default(cuid())
  articleId    String
  url          String?
  title        String?
  publisher    String?
  publishedAt  String?
  sourceType   String   @default("RSS")
  excerpt      String?
  createdAt    DateTime @default(now())

  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model SeoAnalysis {
  id                String   @id @default(cuid())
  articleId         String   @unique
  primaryKeyword    String?
  secondaryKeywords String?
  searchIntent      String?
  titleScore        Int      @default(0)
  metaScore         Int      @default(0)
  keywordScore      Int      @default(0)
  structureScore    Int      @default(0)
  linkScore         Int      @default(0)
  schemaScore       Int      @default(0)
  readabilityScore  Int      @default(0)
  overallScore      Int      @default(0)
  recommendations   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  article           Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model ContentScore {
  id                        String   @id @default(cuid())
  articleId                 String   @unique
  overallScore               Int      @default(0)
  originalityScore           Int      @default(0)
  readabilityScore           Int      @default(0)
  searchIntentScore          Int      @default(0)
  depthScore                 Int      @default(0)
  authorityScore             Int      @default(0)
  factualScore               Int      @default(0)
  internalLinkScore          Int      @default(0)
  monetizationReadinessScore Int      @default(0)
  recommendations            String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  article                    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model InternalLinkRecommendation {
  id              String   @id @default(cuid())
  articleId       String
  targetArticleId String
  relevanceScore  Int      @default(0)
  suggestedAnchor String?
  reason          String?
  status          String   @default("SUGGESTED")
  createdAt       DateTime @default(now())

  article         Article  @relation("LinkSource", fields: [articleId], references: [id], onDelete: Cascade)
  targetArticle   Article  @relation("LinkTarget", fields: [targetArticleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model ContentRefresh {
  id           String   @id @default(cuid())
  articleId    String
  reason       String   @default("AGE")
  status       String   @default("PENDING")
  triggeredAt  DateTime @default(now())
  scheduledFor DateTime?
  completedAt  DateTime?
  notes        String?

  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([scheduledFor])
}

model AiJob {
  id             String   @id @default(cuid())
  siteId         String
  articleId      String?
  type           String
  status         String   @default("QUEUED")
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  estimatedCost  Float?
  error          String?
  retryCount     Int      @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())

  site           Site     @relation(fields: [siteId], references: [id])
  article        Article? @relation(fields: [articleId], references: [id])

  @@index([status])
  @@index([type])
}

// ─── PHASE 2 — MONETIZATION & GROWTH ENGINE ─────────────────

model Subscriber {
  id             String    @id @default(cuid())
  siteId         String
  email          String
  firstName      String?
  status         String    @default("SUBSCRIBED")
  source         String    @default("ARTICLE")
  consentAt      DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  site           Site      @relation(fields: [siteId], references: [id])
  leads          Lead[]
  emailEvents    EmailEvent[]
  affiliateClicks AffiliateClick[]
  productPurchases ProductPurchase[]
  conversionEvents ConversionEvent[]

  @@unique([email, siteId])
  @@index([siteId])
  @@index([status])
}

model Lead {
  id             String   @id @default(cuid())
  siteId         String
  subscriberId   String?
  articleId      String?
  leadMagnetId   String?
  email          String
  firstName      String?
  status         String   @default("CAPTURED")
  source         String   @default("ARTICLE")
  metadata       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site           Site         @relation(fields: [siteId], references: [id])
  subscriber     Subscriber?   @relation(fields: [subscriberId], references: [id])
  article        Article?      @relation(fields: [articleId], references: [id])
  leadMagnet     LeadMagnet?   @relation(fields: [leadMagnetId], references: [id])

  @@index([siteId])
  @@index([articleId])
  @@index([email])
}

model LeadMagnet {
  id               String   @id @default(cuid())
  siteId           String
  name             String
  title            String
  description      String
  fileType         String?
  fileUrl          String?
  ctaText          String
  ctaDescription   String
  thankYouMessage  String
  thankYouUrl      String?
  emailSequenceId  String?
  status           String   @default("ACTIVE")
  deliveryCount    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  site             Site   @relation(fields: [siteId], references: [id])
  leads            Lead[]
  ctas             CallToAction[]
  landingPages     LandingPage[]

  @@index([siteId])
  @@index([status])
}

model EmailCampaign {
  id               String    @id @default(cuid())
  siteId           String
  name             String
  type             String    @default("NEWSLETTER")
  subject          String
  previewText      String?
  content          String
  status           String    @default("DRAFT")
  scheduledAt      DateTime?
  sentAt           DateTime?
  subscriberCount  Int       @default(0)
  openCount        Int       @default(0)
  clickCount       Int       @default(0)
  bounceCount      Int       @default(0)
  unsubscribeCount Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  site             Site          @relation(fields: [siteId], references: [id])
  events           EmailEvent[]

  @@index([siteId])
  @@index([status])
  @@index([type])
}

model EmailEvent {
  id           String   @id @default(cuid())
  siteId       String
  campaignId   String?
  subscriberId String
  type         String   @default("SENT")
  metadata     String?
  createdAt    DateTime @default(now())

  site         Site         @relation(fields: [siteId], references: [id])
  campaign     EmailCampaign? @relation(fields: [campaignId], references: [id])
  subscriber   Subscriber    @relation(fields: [subscriberId], references: [id])

  @@index([siteId])
  @@index([campaignId])
  @@index([subscriberId])
  @@index([type])
  @@index([createdAt])
}

model EmailAutomation {
  id          String   @id @default(cuid())
  siteId      String
  name        String
  triggerType String   @default("SUBSCRIBED")
  steps       String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site        Site     @relation(fields: [siteId], references: [id])

  @@index([siteId])
  @@index([status])
}

model CallToAction {
  id                 String   @id @default(cuid())
  siteId             String
  name               String
  type               String   @default("NEWSLETTER")
  headline           String
  description        String?
  buttonText         String
  buttonUrl          String?
  targetPlacement    String   @default("AFTER_ARTICLE")
  targetArticleId    String?
  targetCategoryId   String?
  targetTagId        String?
  leadMagnetId       String?
  affiliateOfferId   String?
  productId          String?
  isActive           Boolean  @default(true)
  impressionCount    Int      @default(0)
  clickCount         Int      @default(0)
  conversionCount    Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  site               Site            @relation(fields: [siteId], references: [id])
  targetArticle      Article?        @relation(fields: [targetArticleId], references: [id])
  leadMagnet         LeadMagnet?     @relation(fields: [leadMagnetId], references: [id])
  affiliateOffer     AffiliateOffer? @relation(fields: [affiliateOfferId], references: [id])
  product            Product?        @relation(fields: [productId], references: [id])
  placements         CtaPlacement[]
  experiments        CtaExperiment[]

  @@index([siteId])
  @@index([type])
  @@index([targetPlacement])
  @@index([isActive])
}

model CtaPlacement {
  id            String   @id @default(cuid())
  ctaId         String
  articleId     String?
  placement     String   @default("AFTER_ARTICLE")
  position      Int?
  isActive      Boolean  @default(true)
  frequencyCap  Int?
  createdAt     DateTime @default(now())

  cta           CallToAction @relation(fields: [ctaId], references: [id])
  article       Article?     @relation(fields: [articleId], references: [id])

  @@index([ctaId])
  @@index([articleId])
  @@index([placement])
}

model CtaExperiment {
  id                String    @id @default(cuid())
  siteId            String
  name              String
  ctaId             String
  status            String    @default("RUNNING")
  startDate         DateTime
  endDate           DateTime?
  totalImpressions  Int       @default(0)
  totalClicks       Int       @default(0)
  totalConversions  Int       @default(0)
  winnerVariantId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  site              Site         @relation(fields: [siteId], references: [id])
  cta               CallToAction  @relation(fields: [ctaId], references: [id])
  variants          CtaVariant[]

  @@index([siteId])
  @@index([ctaId])
  @@index([status])
}

model CtaVariant {
  id              String   @id @default(cuid())
  experimentId    String
  name            String
  headline        String
  description     String?
  buttonText      String
  buttonUrl       String
  isControl       Boolean  @default(false)
  impressionCount Int      @default(0)
  clickCount      Int      @default(0)
  conversionCount Int      @default(0)
  createdAt       DateTime @default(now())

  experiment      CtaExperiment @relation(fields: [experimentId], references: [id])

  @@unique([experimentId, name])
  @@index([experimentId])
}

model AffiliateProgram {
  id              String   @id @default(cuid())
  siteId          String
  name            String
  network         String?
  website         String?
  commissionType  String?
  commissionValue Float?
  cookieDuration  Int?
  terms           String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  site            Site            @relation(fields: [siteId], references: [id])
  offers          AffiliateOffer[]

  @@index([siteId])
  @@index([status])
}

model AffiliateOffer {
  id               String   @id @default(cuid())
  siteId           String
  programId        String
  name             String
  description      String?
  destinationUrl   String
  affiliateUrl     String
  category         String?
  commission       Float?
  priority         Int      @default(0)
  status           String   @default("ACTIVE")
  clickCount       Int      @default(0)
  conversionCount  Int      @default(0)
  revenueGenerated Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  site             Site             @relation(fields: [siteId], references: [id])
  program          AffiliateProgram @relation(fields: [programId], references: [id])
  clicks           AffiliateClick[]
  ctas             CallToAction[]

  @@index([siteId])
  @@index([programId])
  @@index([status])
  @@index([category])
}

model AffiliateClick {
  id               String   @id @default(cuid())
  siteId           String
  articleId        String?
  offerId          String
  subscriberId     String?
  sessionIdentifier String?
  ip               String?
  userAgent        String?
  referrer         String?
  status           String   @default("CLICKED")
  revenue          Float    @default(0)
  createdAt        DateTime @default(now())

  site             Site         @relation(fields: [siteId], references: [id])
  article          Article?     @relation(fields: [articleId], references: [id])
  offer            AffiliateOffer @relation(fields: [offerId], references: [id])
  subscriber       Subscriber?  @relation(fields: [subscriberId], references: [id])

  @@index([siteId])
  @@index([offerId])
  @@index([articleId])
  @@index([createdAt])
}

model Product {
  id               String   @id @default(cuid())
  siteId           String
  authorId         String?
  name             String
  slug             String
  description      String
  price            Float
  currency         String   @default("NGN")
  productType      String   @default("EBOOK")
  checkoutUrl      String?
  imageUrl         String?
  status           String   @default("DRAFT")
  purchaseCount    Int      @default(0)
  revenueGenerated Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  site             Site      @relation(fields: [siteId], references: [id])
  author           Author?   @relation(fields: [authorId], references: [id])
  purchases        ProductPurchase[]
  ctas             CallToAction[]
  landingPages     LandingPage[]

  @@unique([slug, siteId])
  @@index([siteId])
  @@index([productType])
  @@index([status])
}

model ProductPurchase {
  id             String   @id @default(cuid())
  siteId         String
  productId      String
  articleId      String?
  subscriberId   String?
  email          String
  amount         Float
  currency       String   @default("NGN")
  status         String   @default("PENDING")
  transactionId  String?
  provider       String?
  metadata       String?
  createdAt      DateTime @default(now())

  site           Site        @relation(fields: [siteId], references: [id])
  product        Product     @relation(fields: [productId], references: [id])
  article        Article?    @relation(fields: [articleId], references: [id])
  subscriber     Subscriber? @relation(fields: [subscriberId], references: [id])

  @@index([siteId])
  @@index([productId])
  @@index([articleId])
  @@index([status])
}

model AdPlacement {
  id         String   @id @default(cuid())
  siteId     String
  name       String
  placement  String   @default("IN_ARTICLE")
  provider   String?
  adUnitId   String?
  enabled    Boolean  @default(true)
  articleId  String?
  categoryId String?
  priority   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  site       Site      @relation(fields: [siteId], references: [id])
  events     AdEvent[]

  @@index([siteId])
  @@index([placement])
  @@index([enabled])
}

model AdEvent {
  id               String   @id @default(cuid())
  siteId           String
  placementId      String
  articleId        String?
  type             String   @default("IMPRESSION")
  metadata         String?
  estimatedRevenue Float    @default(0)
  createdAt        DateTime @default(now())

