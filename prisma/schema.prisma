  placement        AdPlacement @relation(fields: [placementId], references: [id])
  article          Article?    @relation(fields: [articleId], references: [id])

  @@index([siteId])
  @@index([placementId])
  @@index([articleId])
  @@index([type])
  @@index([createdAt])
}

