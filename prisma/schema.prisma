  site           Site?         @relation(fields: [siteId], references: [id])

  @@index([organizationId])
  @@index([siteId])
  @@index([keyPrefix])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
