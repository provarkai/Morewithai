// ─── PHASE 3 — MULTI-SITE SAAS PLATFORM ─────────────────────

model Organization {
  id          String   @id @default(cuid())
  name        String
  ownerId     String
  planId      String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner         User     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  plan          Plan?    @relation(fields: [planId], references: [id])
  members       OrganizationMember[]
  sites         Site[]
  subscriptions Subscription[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  usageRecords  UsageRecord[]
  invoices      Invoice[]
  themes        Theme[]
  clientAccounts ClientAccount[]

  // Phase 3 — Command centre, events, money engine
  dashboardSnapshots   DashboardSnapshot[]
  businessHealthScores BusinessHealthScore[]
  nextBestActions      NextBestAction[]
  events               Event[]
  revenueAttributions  RevenueAttribution[]
  contentEconomics     ContentEconomics[]
  moneyOpportunities   MoneyOpportunity[]
  revenueForecasts     RevenueForecast[]
  profitSnapshots      ProfitSnapshot[]
  contentDecayScores   ContentDecayScore[]
  contentConsolidationRecs ContentConsolidationRecommendation[]
  competitors          Competitor[]
  workflows            Workflow[]
  agents               Agent[]
  agentRuns            AgentRun[]
  themeActivations     ThemeActivation[]
  entitlements         Entitlement[]
  usageCounters        UsageCounter[]
  billingEvents        BillingEvent[]

  @@index([status])
}

