// ─── PHASE 3 — COMMAND CENTRE ─────────────────────────────────

model DashboardSnapshot {
  id              String   @id @default(cuid())
  organizationId  String
  siteId          String?
  periodStart     DateTime
  periodEnd       DateTime

  revenue         Float    @default(0)
  profit          Float    @default(0)
  traffic         Int      @default(0)
  leads           Int      @default(0)
  subscribers     Int      @default(0)
  conversionRate  Float    @default(0)
  aiCost          Float    @default(0)

  generatedAt     DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site            Site?        @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([organizationId, periodStart])
  @@index([siteId, periodStart])
}

model BusinessHealthScore {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String?
  metric         String
  score          Int
  confidence     Int      @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  calculatedAt   DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([organizationId, siteId, metric, periodStart, periodEnd])
  @@index([siteId, metric])
}

model NextBestAction {
